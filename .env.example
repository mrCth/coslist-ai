# CosList AI - example environment file. Copy to `.env` and edit as needed.

# --- AI provider ----------------------------------------------------------
# "ollama" (default, local vision model) | "gemini" (cloud) | "text" (text-only fallback)
AI_PROVIDER=ollama
AI_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Gemini (only used when AI_PROVIDER=gemini) ---------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Limits ---------------------------------------------------------------
MAX_IMAGES=4
MAX_IMAGE_BYTES=5242880
MAX_LONG_SIDE=1024
MAX_REQUEST_BYTES=26214400
REQUEST_TIMEOUT_S=240

# --- Rate limiting (per client IP) ----------------------------------------
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_WINDOW_S=60

# --- Storage --------------------------------------------------------------
# DB_PATH=data/coslist.db
# IMAGE_DIR=data/images
# THUMB_DIR=data/thumbs

LOG_LEVEL=INFO
